# Hermes Memory — environment variables
# Copy to .env and fill in. docker-compose.yml requires HERMES_PG_PASSWORD.

HERMES_PG_PASSWORD=change-me

# Postgres DSN used by the provider (C3+)
HERMES_MEMORY_DSN=postgres://hermes:***@localhost:5450/hermes_memory

# AGE graph name
HERMES_MEMORY_GRAPH=hermes_knowledge

# --- Architect v2 autonomous agent (Issue #4) ---

# Kill switch — Architect does nothing unless explicitly enabled.
# Set to 1 / true / yes / on to allow autonomous runs; any other value (including
# unset, 0, false, no) keeps the agent disabled. CI and local dry-runs can pass
# --force to bypass this gate for testing.
HERMES_AGENT_ENABLED=false

# GitHub token used by scripts/architect.py to create PRs via `gh`.
# Create a fine-grained PAT with contents:read + pull-requests:write on rubyrayjuntos/hermes-memory.
# The script also works when `gh auth login` is already configured and this var is empty.
HERMES_GITHUB_TOKEN=

# Webhook URL notified on architect PR creation / failures (optional).
# If set, architect POSTs a JSON payload {event, branch, title, pr_url} to this URL.
# Leave empty to disable webhook notifications.
HERMES_WEBHOOK_URL=

# Pin-memory weighted boost — Librarian C10 tuning (optional, used by hits logger + retrieval)
# When a memory is pinned, its retrieval score is boosted:
#   boosted = base_score * (1 + pin_weight * exp(-age_seconds / ttl))
# pin_weight: multiplicative boost at age 0 (e.g. 1.0 = +100%). 0 disables boost.
# ttl: decay time constant in seconds; 0 means no decay (permanent boost).
# Example: pin_weight=1.0 ttl=86400 keeps a fresh pin at 2x, half-life ~60k s.
HERMES_PIN_WEIGHT=1.0
HERMES_PIN_TTL_SECONDS=86400

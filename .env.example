# ==============================================================================
# 📜 THE HERMES LIBRARIAN — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in. `docker compose` REQUIRES HERMES_PG_PASSWORD.
# Never commit .env — it is gitignored.
# ==============================================================================
# --- DATABASE (RELATIONAL + GRAPH) ---
HERMES_PG_USER=hermes
HERMES_PG_DB=hermes_memory
# Generate a strong password: `openssl rand -base64 24`
HERMES_PG_PASSWORD=change-me
HERMES_PG_HOST_PORT=5450

# --- PGBOUNCER (OPTIONAL, --profile pooled) ---
PGBOUNCER_HOST_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=25

# --- APP DSNs ---
# Direct (default, used by pytest + migrate.py + local dev)
# Provider reads HYBRID_AGE_DSN (secrets stay out of yaml). HERMES_MEMORY_DSN is
# a convenience alias kept for backwards compat — prefer HYBRID_AGE_DSN.
# Replace *** with your password or keep *** if your provider resolves it via {pg_password}.
HYBRID_AGE_DSN=postgresql://hermes:***@127.0.0.1:5450/hermes_memory
# HERMES_MEMORY_DSN is an alias some scripts check — keep in sync with HYBRID_AGE_DSN
HERMES_MEMORY_DSN=postgresql://hermes:***@127.0.0.1:5450/hermes_memory
# Pooled (only when `docker compose --profile pooled up -d` — host 6432 maps to pgbouncer 5432)
HYBRID_AGE_DSN_POOLED=postgresql://hermes:***@127.0.0.1:6432/hermes_memory
HERMES_MEMORY_GRAPH=hermes_knowledge
HYBRID_AGE_GRAPH=hermes_knowledge

# --- EMBEDDINGS ---
# App reads HYBRID_AGE_EMBED_URL / HYBRID_AGE_EMBED_MODEL / HYBRID_AGE_EMBED_KEY
# (config.py + embed.py). HERMES_EMBED_* / OLLAMA_URL are convenience aliases
# documented here so copy-paste from older guides still works — prefer HYBRID_AGE_*.
HYBRID_AGE_EMBED_URL=http://127.0.0.1:11434
HYBRID_AGE_EMBED_MODEL=nomic-embed-text
# For Raspberry Pi 5 fallback, point HYBRID_AGE_EMBED_URL at the Pi:
# HYBRID_AGE_EMBED_URL=http://raspberrypi.local:11434
# HYBRID_AGE_EMBED_URL=http://192.168.1.100:11434
# Convenience aliases (not read by src directly):
HERMES_EMBED_PROVIDER=ollama
HERMES_EMBED_MODEL=nomic-embed-text
# Only if using OpenAI — set the key the embedder reads:
# HYBRID_AGE_EMBED_KEY=sk-proj-...
# OPENAI_API_KEY=sk-proj-...  (alias)

# --- AUTOMATION & KILL SWITCH ---
HERMES_AGENT_ENABLED=false
# Fine-grained PAT (contents:read + pull-requests:write on rubyrayjuntos/hermes-memory)
# Leave empty if `gh auth login` is already configured.
HERMES_GITHUB_TOKEN=
HERMES_WEBHOOK_URL=

# --- PIN-MEMORY BOOST (Librarian C10, optional) ---
# Pin-memory weighted boost — used by hits logger + retrieval
# boosted = base_score * (1 + pin_weight * exp(-age_seconds / ttl))
# pin_weight: multiplicative boost at age 0 (e.g. 1.0 = +100%). 0 disables boost.
# ttl: decay time constant in seconds; 0 means no decay (permanent boost).
HERMES_PIN_WEIGHT=1.0
HERMES_PIN_TTL_SECONDS=86400

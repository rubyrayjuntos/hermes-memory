# Hermes Memory — environment variables
# Copy to .env and fill in. docker-compose.yml requires HERMES_PG_PASSWORD.

HERMES_PG_PASSWORD=change-me

# Postgres DSN used by the provider (C3+)
HERMES_MEMORY_DSN=postgres://hermes:change-me@localhost:5450/hermes_memory

# AGE graph name
HERMES_MEMORY_GRAPH=hermes_knowledge
